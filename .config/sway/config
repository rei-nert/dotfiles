include /etc/sway/config.d/*
# ── Variables ──────────────────────────────────────────────
set $mod Mod4
set $term kitty
set $menu wofi --show drun --prompt "Run:" --width 400 --height 400
set $browser zen-browser
set $lock swaylock -f -c 1e1e2e
set $screenshot grim -g "$(slurp)" $HOME/Pictures/$(date '+%m-%d-%Y-%H%M%S').png
set $cliphist cliphist store
set $clipmenu cliphist list | wofi --dmenu | cliphist decode | wl-copy

# ── Catppuccin Mocha Colors ────────────────────────────────
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b
set $text      #cdd6f4
set $subtext1  #bac2de
set $blue      #89b4fa
set $lavender  #b4befe
set $green     #a6e3a1
set $yellow    #f9e2af
set $red       #f38ba8
set $surface0  #313244

# ── Input/Keyboard ─────────────────────────────────────────
input * {
    xkb_layout br
    xkb_variant abnt2
    xkb_options caps:escape
}

# ── Output/Display ─────────────────────────────────────────
# Configure per-monitor: `swaymsg -t get_outputs`
output eDP-1 resolution 1920x1080 position 0,0 bg $HOME/Nextcloud/Miscellaneous/sukuna-electric-3840x2160-22504.jpg fill

# ── Autostart ───────────────────────────────────────────────
exec gpgconf --launch gpg-agent
exec dunst
exec swaybg -i $HOME/Nextcloud/Miscellaneous/sukuna-electric-3840x2160-22504.jpg -m fill
exec nm-applet --indicator
exec pasystray
exec blueman-applet
exec cliphist listen &
exec waybar

# ── Window Rules ───────────────────────────────────────────
for_window [app_id="Gimp"] floating enable
for_window [class="Firefox"] workspace 9
for_window [app_id="zen"] workspace 9

# ── Layout Defaults ────────────────────────────────────────
# default_layout tiling
# master area ratio (like dwm mfact 0.55)
# sway doesn't have native master/stack; use i3-style splitv/splith

# ── Keybindings ────────────────────────────────────────────
# Launchers
bindsym $mod+p exec $menu
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term
bindsym $mod+Shift+b exec $browser

# Window Management
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left
bindsym $mod+l focus right

bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right

# bindsym $mod+Return  swap container with mark master  # zoom equivalent
bindsym $mod+Shift+c kill

# Layouts
bindsym $mod+t layout tiling
bindsym $mod+f layout tabbed
bindsym $mod+m layout stacked
bindsym $mod+space layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+f fullscreen toggle

# Master area resize (approximation)
bindsym $mod+Left  resize shrink width 10px
bindsym $mod+Right resize grow width 10px
bindsym $mod+Up    resize shrink height 10px
bindsym $mod+Down  resize grow height 10px

# Workspaces (Tags 1-9)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+Control+1 workspace number 1; workspace number 1  # toggleview approximation
bindsym $mod+Control+Shift+1 move container to workspace number 1; workspace number 1  # toggletag approximation

bindsym $mod+0 workspace back_and_forth
bindsym $mod+Shift+0 move container to workspace back_and_forth

# Multi-monitor
bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

# Bar toggle
bindsym $mod+b bar mode toggle

# System
bindsym $mod+Shift+o exec $lock
bindsym Control+Print exec $screenshot
bindsym $mod+c exec $clipmenu

# Notifications (dunst)
bindsym $mod+n exec dunstctl history-pop
bindsym $mod+Shift+n exec dunstctl set-paused toggle
bindsym $mod+x exec dunstctl close

# Reload/Exit
bindsym $mod+Shift+r reload
bindsym $mod+Shift+q exec swaynag -t warning -m "Exit Sway?" -B "Yes" "swaymsg exit"

# ── Mouse Bindings ─────────────────────────────────────────
# Floating move/resize with Mod + mouse
bindsym $mod+Button1 move
bindsym $mod+Button3 resize
