#!/bin/sh

# hermes-smart
# Small model rewrites the request → bigger model runs in Hermes

set -eu

# === CONFIG ===
SMALL_MODEL="gemma2:2b"
HERMES_MODEL="inkling:free" # change if you use a different agent model
OLLAMA_URL="http://127.0.0.1:11434"

# Check dependencies
command -v curl >/dev/null 2>&1 || {
  echo "curl is required" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "jq is required" >&2
  exit 1
}
command -v hermes >/dev/null 2>&1 || {
  echo "hermes is required" >&2
  exit 1
}

# Original request
if [ "$#" -eq 0 ]; then
  echo "Usage: hermes-smart <your request>" >&2
  exit 1
fi

ORIGINAL="$*"

echo "→ Interpreting with $SMALL_MODEL ..."

# Quick health check
if ! curl -sf --max-time 2 "$OLLAMA_URL/api/tags" >/dev/null; then
  echo "Error: cannot reach Ollama at $OLLAMA_URL" >&2
  echo "Is the Ollama server running? (try: ollama serve)" >&2
  exit 1
fi

# Build the rewrite prompt
REWRITE_PROMPT="You are a request rewriter for an AI agent called Hermes.

Your only job:
1. Understand the real goal of the user.
2. Rewrite it into a clear, concise, actionable instruction for the agent.
3. Keep important constraints, paths, formats, and preferences.
4. Remove fluff, conversation, and unnecessary words.
5. Output ONLY the rewritten prompt and nothing else.

User request:
$ORIGINAL"

RAW=$(curl -sS "$OLLAMA_URL/api/chat" \
  -H "Content-Type: application/json" \
  -d "$(jq -n \
    --arg model "$SMALL_MODEL" \
    --arg content "$ORIGINAL" \
    '{
      model: $model,
      stream: false,
      options: {
        temperature: 0.2,
        top_p: 0.9,
        num_ctx: 4096,
        num_predict: -1
      },
      messages: [
        {
          role: "system",
          content: "You are a request rewriter for an AI agent. Rewrite the user prompt into a clear, direct, actionable instruction. Output ONLY the rewritten instruction. Do not include thinking steps or conversation."
        },
        {
          role: "user",
          content: $content
        }
      ]
    }')") || {
  echo "Error: curl failed talking to Ollama" >&2
  exit 1
}

# Extract the response (or error message)
CLEAN_PROMPT=$(printf '%s' "$RAW" | jq -r '.message.content // empty' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
ERROR_MSG=$(printf '%s' "$RAW" | jq -r '.error // empty')

if [ -n "$ERROR_MSG" ]; then
  echo "Error from Ollama: $ERROR_MSG" >&2
  echo "Hint: is the model pulled?  →  ollama pull $SMALL_MODEL" >&2
  exit 1
fi

if [ -z "$CLEAN_PROMPT" ]; then
  echo "Error: small model returned empty response" >&2
  echo "Raw Ollama reply was:" >&2
  printf '%s\n' "$RAW" >&2
  echo >&2
  exit 1
fi

echo
echo "=== Clean prompt for Hermes ==="
echo "$CLEAN_PROMPT"
echo "==============================="
echo
echo "→ Sending to Hermes ($HERMES_MODEL) ..."
echo

hermes chat --model "$HERMES_MODEL" -q "$CLEAN_PROMPT"
